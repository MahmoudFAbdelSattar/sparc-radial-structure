class SPARCFetcher:
    def __init__(self, cfg: Config, reporter: Reporter):
        self.cfg, self.rp = cfg, reporter

    def load(self) -> Dict[str, List[Dict[str, float]]]:
        out = Path(self.cfg.OUTPUT_DIR)
        out.mkdir(parents=True, exist_ok=True)
        new_cache = out / self.cfg.CACHE_FILE

        if new_cache.exists() and not self.cfg.FORCE_REFRESH:
            return self._load_from(new_cache)

        legacy = Path(self.cfg.LEGACY_CACHE_DIR) / self.cfg.CACHE_FILE
        if legacy.exists() and not self.cfg.FORCE_REFRESH:
            self.rp.section(f"Loading cached SPARC from legacy path")
            return self._load_from(legacy)

        return self._download(new_cache)

    def _load_from(self, path: Path) -> Dict[str, List[Dict[str, float]]]:
        self.rp.section(f"Loading cached SPARC ({path})")
        with open(path, "rb") as f:
            galaxies = pickle.load(f)
        n_pts = sum(len(g) for g in galaxies.values())
        self.rp.ok(f"{len(galaxies)} galaxies, {n_pts} points")
        return galaxies

    def _download(self, cache: Path) -> Dict[str, List[Dict[str, float]]]:
        last_err = None
        for url in (self.cfg.SPARC_URL, self.cfg.SPARC_URL_FALLBACK):
            try:
                self.rp.section("Downloading SPARC catalogue")
                self.rp.info(f"URL: {url}")
                resp = requests.get(url, timeout=180,
                                    headers={"User-Agent": f"DiscrepancyMassRelation/{__version__}"})
                resp.raise_for_status()
                self.rp.ok(f"Received {len(resp.text):,} bytes")
                galaxies = self._parse(resp.text)
                with open(cache, "wb") as f:
                    pickle.dump(galaxies, f)
                self.rp.ok(f"Cached → {cache}")
                return galaxies
            except Exception as exc:
                last_err = exc
                self.rp.warn(f"Failed: {exc}")
        raise RuntimeError(f"All downloads failed. Last: {last_err}")

    def _parse(self, text: str) -> Dict[str, List[Dict[str, float]]]:
        galaxies: Dict[str, List[Dict[str, float]]] = {}
        n_total = n_parsed = n_skipped = 0
        for line in text.splitlines():
            s = line.strip()
            if not s or s.startswith("#") or s.startswith("//"): continue
            n_total += 1
            cols = s.split()
            if len(cols) < 8:
                n_skipped += 1; continue
            try:
                name    = cols[0]
                radius  = float(cols[2])
                v_obs   = abs(float(cols[3]))
                v_gas   = abs(float(cols[5]))
                v_disk  = abs(float(cols[6]))
                v_bulge = abs(float(cols[7]))
            except (ValueError, IndexError):
                n_skipped += 1; continue
            if not all(np.isfinite(x) for x in (radius, v_obs, v_gas, v_disk, v_bulge)):
                n_skipped += 1; continue
            galaxies.setdefault(name, []).append({
                "radius": radius, "v_obs": v_obs,
                "v_gas": v_gas, "v_disk": v_disk, "v_bulge": v_bulge,
            })
            n_parsed += 1
        if not galaxies:
            raise RuntimeError("Parser returned zero galaxies.")
        self.rp.info(f"Lines: {n_total}, parsed: {n_parsed}, skipped: {n_skipped}")
        self.rp.ok(f"{len(galaxies)} galaxies, {n_parsed} points")
        return galaxies


