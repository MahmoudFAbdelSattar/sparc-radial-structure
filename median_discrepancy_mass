class DiscrepancyAnalyzer:
    def __init__(self, df, cfg, reporter):
        if df is None or len(df) < 10:
            raise ValueError(f"Insufficient sample: N={0 if df is None else len(df)}")
        self.df = df.copy().reset_index(drop=True)
        self.cfg, self.rp = cfg, reporter
        self.rng = np.random.default_rng(cfg.RANDOM_SEED)
        self.df = DiscrepancySample._enrich_logs(self.df)

    @staticmethod
    def _partial(x, y, z):
        m = np.isfinite(x) & np.isfinite(y) & np.isfinite(z)
        n = int(m.sum())
        if n < 6: return {"rho": np.nan, "p": np.nan, "N": n}
        x, y, z = x[m], y[m], z[m]
        rx = x - np.polyval(np.polyfit(z, x, 1), z)
        ry = y - np.polyval(np.polyfit(z, y, 1), z)
        r = float(np.clip(np.corrcoef(rx, ry)[0, 1], -0.999999, 0.999999))
        t = r * np.sqrt((n - 3) / (1 - r**2))
        return {"rho": r, "p": float(2 * stats.t.sf(abs(t), df=n - 3)), "N": n}

    def _fit_ols(self, y_col, predictors):
        y = self.df[y_col].to_numpy()
        cols = [self.df[p].to_numpy() for p in predictors]
        m = np.isfinite(y)
        for c in cols: m &= np.isfinite(c)
        n = int(m.sum())
        if n < self.cfg.MIN_TOTAL_POINTS:
            raise ValueError(f"Too few rows: N={n}")
        X = sm.add_constant(np.column_stack([c[m] for c in cols]))
        return sm.OLS(y[m], X).fit(), n, X

    def fit_main_relation(self, y_col: str = "phi_end", bootstrap: bool = True):
        x = self.df["log_M_bar"].to_numpy()
        y = self.df[y_col].to_numpy()
        m = np.isfinite(x) & np.isfinite(y)
        x, y = x[m], y[m]
        n = int(m.sum())
        if n < self.cfg.MIN_TOTAL_POINTS:
            raise ValueError(f"Too few valid rows: N={n}")
        model = sm.OLS(y, sm.add_constant(x)).fit()
        res = {
            "N": n,
            "intercept": float(model.params[0]), "intercept_se": float(model.bse[0]),
            "slope": float(model.params[1]), "slope_se": float(model.bse[1]),
            "R2": float(model.rsquared), "R2_adj": float(model.rsquared_adj),
            "equation": f"{y_col} = {model.params[0]:.3f} {model.params[1]:+.3f} logM",
            "x": x, "y": y, "model": model,
        }
        r, p = stats.pearsonr(x, y); rho, ps = stats.spearmanr(x, y)
        res.update({"pearson_r": float(r), "pearson_p": float(p),
                    "spearman_rho": float(rho), "spearman_p": float(ps)})
        if bootstrap:
            nb = self.cfg.BOOTSTRAP_N
            slopes = np.empty(nb); icepts = np.empty(nb)
            for i in range(nb):
                idx = self.rng.integers(0, n, size=n)
                b = stats.linregress(x[idx], y[idx])
                slopes[i], icepts[i] = b.slope, b.intercept
            a = 1 - self.cfg.BOOTSTRAP_CONF
            lo, hi = 100*a/2, 100*(1 - a/2)
            res["slope_ci"] = [float(np.percentile(slopes, lo)),
                               float(np.percentile(slopes, hi))]
            res["intercept_ci"] = [float(np.percentile(icepts, lo)),
                                   float(np.percentile(icepts, hi))]
        return res

    def compute_btfr_rm_consistency(self):
        self.rp.section("BTFR + R(M) consistency test")
        x = self.df["log_M_bar"].to_numpy()
        log_vobs = self.df["log_vobs_Rmax"].to_numpy()
        log_vbar = self.df["log_vbar_Rmax"].to_numpy()
        log_Rmax = self.df["log_R_max"].to_numpy()
        phi_Rmax = self.df["phi_Rmax"].to_numpy()
        m = np.isfinite(x) & np.isfinite(log_vobs) & np.isfinite(log_vbar) & \
            np.isfinite(log_Rmax) & np.isfinite(phi_Rmax)
        x, log_vobs, log_vbar, log_Rmax, phi_Rmax = (
            x[m], log_vobs[m], log_vbar[m], log_Rmax[m], phi_Rmax[m])

        btfr = stats.linregress(x, log_vobs)
        rm = stats.linregress(x, log_Rmax)
        obs = stats.linregress(x, phi_Rmax)
        predicted_slope = (btfr.slope - 0.5 + rm.slope / 2.0) * np.log(10)
        residual = obs.slope - predicted_slope

        result = {
            "N": int(len(x)),
            "btfr_slope_alpha":  float(btfr.slope),
            "btfr_intercept_beta": float(btfr.intercept),
            "btfr_r": float(btfr.rvalue),
            "rm_slope_p":  float(rm.slope),
            "rm_intercept_q": float(rm.intercept),
            "rm_r": float(rm.rvalue),
            "predicted_slope": float(predicted_slope),
            "observed_slope":  float(obs.slope),
            "observed_intercept": float(obs.intercept),
            "observed_r": float(obs.rvalue),
            "observed_R2": float(obs.rvalue**2),
            "residual": float(residual),
            "agreement_pct": float(abs(residual) / abs(predicted_slope) * 100) if predicted_slope != 0 else np.nan,
        }
        self.rp.info(f"BTFR on sample: α = {btfr.slope:+.3f}, r = {btfr.rvalue:+.3f}")
        self.rp.info(f"R(M) on sample: p = {rm.slope:+.3f}, r = {rm.rvalue:+.3f}")
        self.rp.info(f"Predicted slope: {predicted_slope:+.3f}")
        self.rp.info(f"Observed slope : {obs.slope:+.3f}")
        self.rp.info(f"Residual       : {residual:+.4f}")
        if abs(residual) < 0.02:
            self.rp.ok("φ(R_max) IS fully explained by BTFR + R(M)")
        else:
            self.rp.warn(f"Residual {residual:+.3f} is non-negligible")
        return result

    def compute_radial_structure(self):
        self.rp.section("Radial structure analysis (Δφ)")
        df = self.df.copy()
        df["delta_phi"] = df["phi_end"] - df["phi_Rmax"]

        delta = df["delta_phi"].dropna().to_numpy()
        stats_summary = {
            "N": int(len(delta)),
            "mean": float(delta.mean()),
            "std": float(delta.std()),
            "median": float(np.median(delta)),
            "Q1": float(np.percentile(delta, 25)),
            "Q3": float(np.percentile(delta, 75)),
            "min": float(delta.min()),
            "max": float(delta.max()),
        }
        self.rp.info(f"Δφ: mean={stats_summary['mean']:+.4f}, "
                     f"median={stats_summary['median']:+.4f}, "
                     f"std={stats_summary['std']:.4f}")

        raw_corrs = {}
        for var in ["log_R_max", "log_M_bar", "log_M_disk", "log_M_gas",
                    "log_Sigma", "f_gas"]:
            if var not in df.columns: continue
            v = df[var].to_numpy(); d = df["delta_phi"].to_numpy()
            mm = np.isfinite(v) & np.isfinite(d)
            if mm.sum() < 10: continue
            r, p = stats.pearsonr(d[mm], v[mm])
            raw_corrs[var] = {"r": float(r), "p": float(p), "N": int(mm.sum())}
            self.rp.info(f"  r(Δφ, {var:12s}) = {r:+.3f}, p = {p:.2e}")

        partial_corrs = {}
        for var in ["log_R_max", "f_gas", "log_Sigma"]:
            if var not in df.columns: continue
            res = self._partial(df["delta_phi"].to_numpy(),
                                df[var].to_numpy(),
                                df["log_M_bar"].to_numpy())
            partial_corrs[var] = res
            self.rp.info(f"  r(Δφ, {var:12s} | M_bar) = {res['rho']:+.3f}, p = {res['p']:.2e}")

        tertiles = self._compute_tertile_stability(df)
        self.rp.info("Δφ ~ R_max by M_bar tertile:")
        for name, val in tertiles.items():
            self.rp.info(f"  {name:6s}: N={val['N']:3d}, r={val['r']:+.3f}, p={val['p']:.2e}")

        x = df["log_M_bar"].to_numpy(); d = df["delta_phi"].to_numpy()
        mm = np.isfinite(x) & np.isfinite(d)
        delta_fit = stats.linregress(x[mm], d[mm])

        return {
            "statistics": stats_summary,
            "raw_correlations": raw_corrs,
            "partial_correlations": partial_corrs,
            "tertiles": tertiles,
            "delta_vs_mbar": {
                "slope": float(delta_fit.slope),
                "intercept": float(delta_fit.intercept),
                "r": float(delta_fit.rvalue),
                "p": float(delta_fit.pvalue),
                "N": int(mm.sum()),
            },
        }

    def _compute_tertile_stability(self, df: pd.DataFrame) -> Dict[str, Dict[str, float]]:
        df = df.copy()
        mask = np.isfinite(df["log_M_bar"]) & np.isfinite(df["delta_phi"]) & np.isfinite(df["log_R_max"])
        df = df[mask].reset_index(drop=True)
        if len(df) < 20: return {}
        try:
            df["M_ter"] = pd.qcut(df["log_M_bar"], 3, labels=["low", "mid", "high"])
        except ValueError:
            return {}
        out = {}
        for label in ["low", "mid", "high"]:
            grp = df[df["M_ter"] == label]
            if len(grp) < 5: continue
            try:
                r, p = stats.pearsonr(grp["delta_phi"], grp["log_R_max"])
                out[label] = {"N": int(len(grp)), "r": float(r), "p": float(p)}
            except Exception:
                continue
        return out

    def correlation_table(self, y_col: str = "phi_end"):
        y = self.df[y_col].to_numpy(); rows = []
        for v in ["log_M_bar", "log_M_disk", "log_M_gas", "log_R_max", "log_Sigma", "f_gas"]:
            if v not in self.df: continue
            x = self.df[v].to_numpy()
            m = np.isfinite(x) & np.isfinite(y)
            if m.sum() < self.cfg.MIN_TOTAL_POINTS: continue
            rho, p = stats.spearmanr(x[m], y[m]); r, _ = stats.pearsonr(x[m], y[m])
            rows.append({"variable": v, "spearman_rho": float(rho),
                         "spearman_p": float(p), "pearson_r": float(r), "N": int(m.sum())})
        return pd.DataFrame(rows).sort_values("spearman_rho").reset_index(drop=True)

    def partial_table(self, y_col: str = "phi_end"):
        y = self.df[y_col].to_numpy(); rows = []
        for var, ctrl in [("log_M_gas","log_M_bar"),("log_M_disk","log_M_gas"),
                          ("log_M_disk","log_M_bar"),("log_M_bar","log_M_disk"),
                          ("f_gas","log_M_bar")]:
            if var not in self.df or ctrl not in self.df: continue
            r = self._partial(self.df[var].to_numpy(), y, self.df[ctrl].to_numpy())
            rows.append({"variable": var, "controlling_for": ctrl,
                         "partial_rho": r["rho"], "p_value": r["p"], "N": r["N"]})
        return pd.DataFrame(rows)

    def multivariate_models(self):
        specs = [
            ("M_bar",              ["log_M_bar"]),
            ("M_disk",             ["log_M_disk"]),
            ("M_bar + Σ",          ["log_M_bar","log_Sigma"]),
            ("M_disk + Σ",         ["log_M_disk","log_Sigma"]),
            ("M_bar + f_gas + Σ",  ["log_M_bar","f_gas","log_Sigma"]),
        ]
        rows = []
        for name, preds in specs:
            try:
                mdl, n, _ = self._fit_ols("phi_end", preds)
                rows.append({"model": name, "predictors": ", ".join(preds),
                             "k": len(preds), "N": n,
                             "R2": float(mdl.rsquared),
                             "R2_adj": float(mdl.rsquared_adj),
                             "AIC": float(mdl.aic), "BIC": float(mdl.bic)})
            except Exception as exc:
                self.rp.warn(f"Model '{name}' skipped: {exc}")
        return pd.DataFrame(rows).sort_values("R2", ascending=False).reset_index(drop=True)

    def cross_validation(self):
        specs = [("M_bar",["log_M_bar"]),("M_bar + Σ",["log_M_bar","log_Sigma"]),
                 ("M_bar + f_gas + Σ",["log_M_bar","f_gas","log_Sigma"])]
        kf = KFold(n_splits=self.cfg.CV_SPLITS, shuffle=True, random_state=self.cfg.RANDOM_SEED)
        rows = []
        for name, preds in specs:
            try:
                cols = [self.df[p].to_numpy() for p in preds]
                y = self.df["phi_end"].to_numpy()
                m = np.isfinite(y)
                for c in cols: m &= np.isfinite(c)
                X = np.column_stack([c[m] for c in cols]); yv = y[m]
                if len(yv) < self.cfg.MIN_TOTAL_POINTS: continue
                r2s, rms = [], []
                for tr, te in kf.split(X):
                    mdl = LinearRegression().fit(X[tr], yv[tr])
                    yp = mdl.predict(X[te])
                    r2s.append(mdl.score(X[te], yv[te]))
                    rms.append(float(np.sqrt(np.mean((yv[te] - yp)**2))))
                rows.append({"model": name, "predictors": ", ".join(preds),
                             "R2_cv_mean": float(np.mean(r2s)),
                             "R2_cv_std": float(np.std(r2s)),
                             "RMSE_cv_mean": float(np.mean(rms)), "N": int(len(yv))})
            except Exception as exc:
                self.rp.warn(f"CV '{name}' skipped: {exc}")
        return pd.DataFrame(rows).sort_values("R2_cv_mean", ascending=False).reset_index(drop=True)

    def circularity_test(self):
        logM = self.df["log_M_bar"].to_numpy()
        phi = self.df["phi_end"].to_numpy()
        vo = self.df["v_obs_Rmax"].to_numpy()
        vb = self.df["v_bar_Rmax"].to_numpy()
        def _r(a, b):
            m = np.isfinite(a) & np.isfinite(b)
            if m.sum() < 10: return np.nan, np.nan, 0
            r, p = stats.pearsonr(a[m], b[m]); return float(r), float(p), int(m.sum())
        rv, pv, n1 = _r(logM, vo); rb, pb, n2 = _r(logM, vb)
        rp, pp, n3 = _r(logM, phi); rbv, _, _ = _r(vb, vo)
        return {"r_Mbar_vobs": rv, "p_Mbar_vobs": pv, "r_Mbar_vbar": rb,
                "p_Mbar_vbar": pb, "r_Mbar_phi": rp, "p_Mbar_phi": pp,
                "r_vbar_vobs": rbv, "N": min(n1, n2, n3)}

    def residual_diagnostics(self, main_result=None):
        main = main_result if main_result is not None else self.fit_main_relation()
        model = main["model"]; x = main["x"]
        residuals = np.asarray(model.resid)
        shapiro_W = shapiro_p = np.nan
        if len(residuals) <= 5000:
            shapiro_W, shapiro_p = stats.shapiro(residuals)
        _, bp_p, _, _ = het_breuschpagan(residuals, sm.add_constant(x))
        sigma = float(np.std(residuals, ddof=1))
        outlier_mask = np.abs(residuals) > 3 * sigma
        names = self.df.get("name", pd.Series(["?"]*len(self.df))).to_numpy()
        y = self.df["phi_end"].to_numpy(); lm = self.df["log_M_bar"].to_numpy()
        mask = np.isfinite(y) & np.isfinite(lm)
        outlier_names = names[mask][outlier_mask].tolist() if outlier_mask.any() else []
        return {"residuals": residuals, "fitted": np.asarray(model.fittedvalues),
                "x_logM": x, "rms": sigma,
                "shapiro_W": float(shapiro_W) if np.isfinite(shapiro_W) else np.nan,
                "shapiro_p": float(shapiro_p) if np.isfinite(shapiro_p) else np.nan,
                "bp_p": float(bp_p),
                "skewness": float(stats.skew(residuals)),
                "kurtosis_excess": float(stats.kurtosis(residuals)),
                "n_outliers": int(outlier_mask.sum()),
                "outlier_names": outlier_names}

    def ml_sensitivity_rigorous(self, galaxies, upsilon_values=None):
        if upsilon_values is None: upsilon_values = self.cfg.ML_SWEEP
        self.rp.section("TRUE fixed-sample M/L sensitivity")
        ref_names = set(self.df["name"].tolist())
        results = {}
        for U in upsilon_values:
            fd = np.sqrt(U / UPSILON_REF_DISK); fb = 1.0
            new_phi, new_logM = [], []
            survived, disappeared = [], []
            degraded = 0
            for name in sorted(ref_names):
                pts = galaxies[name]
                valid = []
                for p in pts:
                    try:
                        vg, vd, vb = float(p["v_gas"]), float(p["v_disk"]), float(p["v_bulge"])
                        vo, r = float(p["v_obs"]), float(p["radius"])
                    except (KeyError, ValueError, TypeError): continue
                    if not all(np.isfinite(x) for x in (vg, vd, vb, vo, r)): continue
                    vbar = float(np.sqrt(vg**2 + (vd*fd)**2 + (vb*fb)**2))
                    if vbar < self.cfg.V_BAR_MIN_KMS: continue
                    if vo <= vbar: continue
                    phi = float(np.log(vo/vbar))
                    if not np.isfinite(phi) or phi >= self.cfg.PHI_MAX: continue
                    valid.append({"r": r, "phi": phi, "vbar": vbar})
                if len(valid) == 0:
                    disappeared.append(name); continue
                sat = [v for v in valid if v["r"] >= self.cfg.R_SAT_KPC]
                if len(sat) >= self.cfg.N_SAT_MIN:
                    phi_vals = [s["phi"] for s in sat]
                elif len(sat) >= 1:
                    degraded += 1
                    phi_vals = [s["phi"] for s in sat]
                else:
                    degraded += 1
                    phi_vals = [v["phi"] for v in valid]
                rmax = max(valid, key=lambda x: x["r"])
                Mbar = MASS_FACTOR * rmax["vbar"]**2 * rmax["r"]
                if not np.isfinite(Mbar) or Mbar <= 0:
                    disappeared.append(name); continue
                new_phi.append(float(np.median(phi_vals)))
                new_logM.append(float(np.log10(Mbar)))
                survived.append(name)
            if len(new_phi) < 10:
                results[U] = {"N": len(new_phi), "slope": np.nan,
                              "N_disappeared": len(disappeared), "N_degraded": degraded}
                continue
            fit = stats.linregress(new_logM, new_phi)
            results[U] = {
                "N": len(new_phi), "N_disappeared": len(disappeared),
                "N_degraded": degraded,
                "survived": survived, "disappeared": disappeared,
                "slope": float(fit.slope), "intercept": float(fit.intercept),
                "r": float(fit.rvalue), "R2": float(fit.rvalue**2),
            }
            d = f", {len(disappeared)} disappeared" if disappeared else ""
            g = f", {degraded} degraded" if degraded else ""
            self.rp.info(f"Υ={U:.1f} : N={len(new_phi):3d}, slope={fit.slope:+.3f}, "
                         f"r={fit.rvalue:+.3f}, R²={fit.rvalue**2:.3f}{d}{g}")
        return results

    def selection_effect_analysis(self, galaxies):
        self.rp.section("Selection-effect analysis (progressive M_bar cuts)")
        rows = []
        for cutoff in self.cfg.CUT_SWEEP:
            cfg_u = Config(**{**asdict(self.cfg), "M_BAR_MAX_MSUN": cutoff})
            sample = DiscrepancySample(cfg_u, Reporter(verbose=False)).build(galaxies)
            if len(sample) < 10: continue
            analyzer = DiscrepancyAnalyzer(sample, cfg_u, Reporter(verbose=False))
            m = analyzer.fit_main_relation(bootstrap=False)
            rows.append({"cutoff": cutoff, "N": m["N"], "slope": m["slope"],
                         "intercept": m["intercept"], "r": m["pearson_r"],
                         "R2": m["R2"], "spearman_rho": m["spearman_rho"]})
            label = "no cut" if cutoff >= 1e15 else f"{cutoff:.0e}"
            self.rp.info(f"{label:>8s} : N={m['N']:3d}, slope={m['slope']:+.3f}, "
                         f"r={m['pearson_r']:+.3f}, R²={m['R2']:.3f}")
        return pd.DataFrame(rows)

    def r_sat_analysis(self, galaxies):
        self.rp.section("Saturated-regime threshold sensitivity (r_sat sweep)")
        rows = []
        for rs in self.cfg.R_SAT_SWEEP:
            cfg_u = Config(**{**asdict(self.cfg), "R_SAT_KPC": rs})
            sample = DiscrepancySample(cfg_u, Reporter(verbose=False)).build(galaxies)
            if len(sample) < 10: continue
            analyzer = DiscrepancyAnalyzer(sample, cfg_u, Reporter(verbose=False))
            m = analyzer.fit_main_relation(bootstrap=False)
            rows.append({"r_sat": rs, "N": m["N"], "slope": m["slope"],
                         "intercept": m["intercept"], "r": m["pearson_r"],
                         "R2": m["R2"]})
            self.rp.info(f"r_sat={rs:.1f} : N={m['N']:3d}, slope={m['slope']:+.3f}, "
                         f"r={m['pearson_r']:+.3f}, R²={m['R2']:.3f}")
        return pd.DataFrame(rows)

    def disappearing_galaxies_properties(self, ml_results, upsilon_disappear=1.4):
        self.rp.section("Properties of disappearing galaxies")
        if upsilon_disappear not in ml_results: return {}
        r = ml_results[upsilon_disappear]
        disappeared = r.get("disappeared", [])
        if not disappeared: return {"N_disappeared": 0}
        ref_df = self.df.set_index("name")
        dis_mask = ref_df.index.isin(disappeared)
        dis_df = ref_df[dis_mask]; sur_df = ref_df[~dis_mask]
        props = ["log_M_bar", "phi_end", "R_max", "Sigma", "f_gas"]
        summary = {"N_disappeared": len(dis_df), "N_survived": len(sur_df),
                   "upsilon": upsilon_disappear, "properties": {}}
        for p in props:
            if p not in ref_df.columns: continue
            summary["properties"][p] = {
                "dis_median": float(dis_df[p].median()),
                "dis_iqr": float(dis_df[p].quantile(0.75) - dis_df[p].quantile(0.25)),
                "sur_median": float(sur_df[p].median()),
                "sur_iqr": float(sur_df[p].quantile(0.75) - sur_df[p].quantile(0.25)),
            }
            self.rp.info(f"{p:12s} : disappeared={dis_df[p].median():.2f}, "
                         f"survived={sur_df[p].median():.2f}")
        summary["disappeared_names"] = disappeared
        return summary

    def run_all(self, galaxies):
        rp = self.rp; R: Dict[str, Any] = {}
        rp.section("Statistical analysis")
        rp.info(f"Sample size: N = {len(self.df)}")

        R["main_median"] = self.fit_main_relation("phi_end")
        R["main_endpoint"] = self.fit_main_relation("phi_Rmax")
        rp.info(f"φ_end (median):   slope = {R['main_median']['slope']:+.3f}, "
                f"r = {R['main_median']['pearson_r']:+.3f}, R² = {R['main_median']['R2']:.3f}")
        rp.info(f"φ(R_max) endpoint: slope = {R['main_endpoint']['slope']:+.3f}, "
                f"r = {R['main_endpoint']['pearson_r']:+.3f}, R² = {R['main_endpoint']['R2']:.3f}")

        R["btfr_consistency"] = self.compute_btfr_rm_consistency()
        R["radial_structure"] = self.compute_radial_structure()

        R["correlations"] = self.correlation_table()
        R["partials"] = self.partial_table()
        R["models"] = self.multivariate_models()
        R["cv"] = self.cross_validation()
        R["circularity"] = self.circularity_test()
        R["residuals"] = self.residual_diagnostics(R["main_median"])

        R["ml_rigorous"] = self.ml_sensitivity_rigorous(galaxies)
        R["selection_effects"] = self.selection_effect_analysis(galaxies)
        R["r_sat_effects"] = self.r_sat_analysis(galaxies)
        R["disappearing"] = self.disappearing_galaxies_properties(R["ml_rigorous"])

        return R


