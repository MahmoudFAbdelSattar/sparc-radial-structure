def _parse_cli(argv: Optional[Sequence[str]] = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="median_discrepancy_mass",
        description=f"Radial Structure pipeline — version {__version__}",
    )
    parser.add_argument("--force-refresh", action="store_true")
    parser.add_argument("--quiet", action="store_true")
    parser.add_argument("--output-dir", type=str, default=None)
    parser.add_argument("--seed", type=int, default=42)
    parser.add_argument("--version", action="version", version=f"median_discrepancy_mass {__version__}")
    args, _ = parser.parse_known_args(argv)
    return args


def main(argv: Optional[Sequence[str]] = None) -> int:
    args = _parse_cli(argv)
    overrides: Dict[str, Any] = {"FORCE_REFRESH": args.force_refresh, "RANDOM_SEED": args.seed}
    if args.output_dir:
        overrides["OUTPUT_DIR"] = args.output_dir
    cfg = Config(**overrides)
    result = run_pipeline(cfg, verbose=not args.quiet)
    return 0 if result.get("status") == "ok" else 1


if __name__ == "__main__":
    sys.exit(main())
