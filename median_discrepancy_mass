            return
        fig, ax = plt.subplots(figsize=(8, 5.6))
        colors = {"low": "#1f77b4", "mid": "#2ca02c", "high": "#d62728"}
        markers = {"low": "o", "mid": "s", "high": "^"}
        for label in ["low", "mid", "high"]:
            grp = df[df["M_ter"] == label]
            if len(grp) < 5:
                continue
            try:
                fit = stats.linregress(grp["log_R_max"], grp["delta_phi"])
            except Exception:
                continue
            r_val = self.radial["tertiles"].get(label, {}).get("r", np.nan)
            ax.scatter(grp["log_R_max"], grp["delta_phi"],
                       color=colors[label], marker=markers[label],
                       s=35, alpha=0.75, edgecolors="black", lw=0.3,
                       label=f"{label} mass: r = {r_val:+.3f}")
            xf = np.linspace(grp["log_R_max"].min(), grp["log_R_max"].max(), 50)
            ax.plot(xf, fit.intercept + fit.slope*xf, color=colors[label], lw=1.5, alpha=0.8)
        ax.set_xlabel(r"$\log_{10}(R_{\rm max}/{\rm kpc})$")
        ax.set_ylabel(r"$\Delta\phi$")
        ax.set_title("Radial structure is robust across mass tertiles")
        ax.legend(loc="best", fontsize=9); ax.grid(alpha=0.3, ls=":")
        plt.tight_layout()
        out = self.fig_dir / "figure4_tertile_stability.pdf"
        plt.savefig(out); plt.close()
        print(f"  ✓ {out}")

    def figure5_residuals(self):
