def run_pipeline(cfg: Optional[Config] = None, verbose: bool = True) -> Dict[str, Any]:
    cfg = cfg or Config()
    rp = Reporter(verbose)

    rp.header(f"Radial Structure in the Mass Discrepancy  (v{__version__})")
    rp.info(f"Config fingerprint : {cfg.fingerprint()}")
    rp.info(f"Python             : {platform.python_version()}")
    rp.info(f"NumPy / Pandas     : {np.__version__} / {pd.__version__}")
    rp.info(f"Random seed        : {cfg.RANDOM_SEED}")

    galaxies = SPARCFetcher(cfg, rp).load()

    sample_builder = DiscrepancySample(cfg, rp)
    df = sample_builder.build(galaxies)

    if len(df) < 10:
        rp.error(f"Insufficient sample: N={len(df)}")
        return {"status": "failed_small_sample", "cfg": cfg, "df": df,
                "sample_counts": sample_builder.counts(),
                "rejection_log": sample_builder.rejections_df()}

    analyzer = DiscrepancyAnalyzer(df, cfg, rp)
    results = analyzer.run_all(galaxies)

    out = Path(cfg.OUTPUT_DIR)
    out.mkdir(parents=True, exist_ok=True)
    rp.section("Exporting artefacts")

    df.to_csv(out / "sample_final.csv", index=False)
    rp.ok(f"sample_final.csv ({len(df)} rows, {len(df.columns)} cols)")

    results["correlations"].to_csv(out / "table2_correlations.csv", index=False)
    results["partials"].to_csv(out / "table3_partials.csv", index=False)
    results["models"].to_csv(out / "table4_models.csv", index=False)
    results["cv"].to_csv(out / "table6_cv.csv", index=False)
    results["selection_effects"].to_csv(out / "table7_selection.csv", index=False)
    results["r_sat_effects"].to_csv(out / "table8_r_sat.csv", index=False)
    rp.ok("CSV tables 2, 3, 4, 6, 7, 8")

    pd.DataFrame([
        {"quantity": k, "value": v}
        for k, v in results["btfr_consistency"].items()
        if not isinstance(v, (list, dict))
    ]).to_csv(out / "table9_btfr_consistency.csv", index=False)
    rp.ok("table9_btfr_consistency.csv")

    radial_rows = []
    for k, v in results["radial_structure"]["raw_correlations"].items():
        radial_rows.append({"type": "raw", "variable": k, **v})
    for k, v in results["radial_structure"]["partial_correlations"].items():
        radial_rows.append({"type": "partial|Mbar", "variable": k, **v})
    pd.DataFrame(radial_rows).to_csv(out / "table10_radial_structure.csv", index=False)
    rp.ok("table10_radial_structure.csv")

    sample_builder.rejections_df().to_csv(out / "rejection_log.csv", index=False)

    ml_rows = []
    for U, r in results["ml_rigorous"].items():
        ml_rows.append({"upsilon_disk": U, "N_kept": r.get("N", 0),
                        "N_disappeared": r.get("N_disappeared", 0),
                        "N_degraded": r.get("N_degraded", 0),
                        "slope": r.get("slope", np.nan),
                        "intercept": r.get("intercept", np.nan),
                        "r": r.get("r", np.nan),
                        "R2": r.get("R2", np.nan)})
    pd.DataFrame(ml_rows).to_csv(out / "table5_ml_sensitivity.csv", index=False)

    if results.get("disappearing", {}).get("N_disappeared", 0) > 0:
        dis_df = pd.DataFrame([{"name": n}
                               for n in results["disappearing"]["disappeared_names"]])
        dis_df.to_csv(out / "table11_disappearing.csv", index=False)

    def _scipy_ver():
        try:
            import scipy as _s
            return getattr(_s, "__version__", "unknown")
        except Exception:
            return "unknown"

    manifest = {
        "version": __version__,
        "timestamp_utc": datetime.now(timezone.utc).isoformat(),
        "cfg_fingerprint": cfg.fingerprint(),
        "cfg": asdict(cfg),
        "environment": {
            "python": platform.python_version(),
            "numpy": np.__version__, "pandas": pd.__version__,
            "scipy": _scipy_ver(),
            "statsmodels": __import__("statsmodels").__version__,
            "sklearn": __import__("sklearn").__version__,
        },
        "main_median": {k: (float(v) if isinstance(v, (int, float, np.floating)) else
                            (list(map(float, v)) if isinstance(v, list) else str(v)))
                        for k, v in results["main_median"].items()
                        if k not in ("x", "y", "model")},
        "main_endpoint": {k: (float(v) if isinstance(v, (int, float, np.floating)) else
                              (list(map(float, v)) if isinstance(v, list) else str(v)))
                          for k, v in results["main_endpoint"].items()
                          if k not in ("x", "y", "model")},
        "btfr_consistency": {k: (float(v) if isinstance(v, (int, float, np.floating)) else v)
                             for k, v in results["btfr_consistency"].items()},
        "radial_structure_summary": {
            "delta_mean": float(results["radial_structure"]["statistics"]["mean"]),
            "delta_median": float(results["radial_structure"]["statistics"]["median"]),
            "r_delta_Rmax_partial": float(results["radial_structure"]["partial_correlations"]
                                          .get("log_R_max", {}).get("rho", np.nan)),
            "p_delta_Rmax_partial": float(results["radial_structure"]["partial_correlations"]
                                          .get("log_R_max", {}).get("p", np.nan)),
            "tertile_r": {k: float(v["r"]) for k, v in results["radial_structure"]["tertiles"].items()},
        },
    }
    with open(out / "run_manifest.json", "w") as f:
        json.dump(manifest, f, indent=2, default=str)
    rp.ok("run_manifest.json")

    results["df"] = df
    results["cfg"] = cfg
    results["rejection_log"] = sample_builder.rejections_df()
    results["sample_counts"] = sample_builder.counts()
    results["all_galaxies"] = galaxies

    visualizer = PaperVisualizer(results, str(out))
    visualizer.render_all()

    rp.header("ANALYSIS COMPLETE")
    rp.info(f"Final N                              : {len(df)}")
    rp.info(f"φ_end slope (median)                 : {results['main_median']['slope']:+.3f}")
    rp.info(f"φ(R_max) slope (endpoint)            : {results['main_endpoint']['slope']:+.3f}")
    rp.info(f"BTFR + R(M) predicted slope          : {results['btfr_consistency']['predicted_slope']:+.3f}")
    rp.info(f"Residual (observed − predicted)      : {results['btfr_consistency']['residual']:+.4f}")
    rp.info(f"Δφ mean                              : {results['radial_structure']['statistics']['mean']:+.4f}")
    rp.info(f"r(Δφ, R_max | M_bar)                 : "
            f"{results['radial_structure']['partial_correlations'].get('log_R_max', {}).get('rho', np.nan):+.3f}")
    rp.info(f"Output directory                     : {out.resolve()}")

    results["status"] = "ok"
    results["run_metadata"] = manifest
    return results


