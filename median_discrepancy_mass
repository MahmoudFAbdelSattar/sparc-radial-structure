class DiscrepancySample:
    EXPECTED_COLUMNS: Tuple[str, ...] = (
        "name", "N_total", "N_valid", "N_saturated",
        "R_max", "v_bar_Rmax", "v_obs_Rmax", "v_gas_Rmax", "v_disk_Rmax", "v_bulge_Rmax",
        "phi_end", "phi_end_mean", "phi_Rmax",
        "M_bar", "M_disk", "M_gas", "M_bulge",
        "Sigma", "f_gas",
        "log_M_bar", "log_M_disk", "log_M_gas", "log_R_max", "log_Sigma",
        "log_vbar_Rmax", "log_vobs_Rmax",
    )

    def __init__(self, cfg: Config, reporter: Reporter):
        self.cfg, self.rp = cfg, reporter
        self._reset()

    def _reset(self):
        self._rejections: List[Tuple[str, str, str]] = []
        self._counts = {"input": 0, "with_valid_points": 0,
                        "with_sat_points": 0, "after_mass_cut": 0,
                        "final": 0, "total_sat_points": 0}

    def _v_bar(self, vg, vd, vb) -> float:
        fd = np.sqrt(self.cfg.UPSILON_DISK / UPSILON_REF_DISK)
        fb = np.sqrt(self.cfg.UPSILON_BULGE / UPSILON_REF_BULGE)
        return float(np.sqrt(vg**2 + (vd*fd)**2 + (vb*fb)**2))

    def _masses(self, vg, vd, vb, R):
        fd = np.sqrt(self.cfg.UPSILON_DISK / UPSILON_REF_DISK)
        fb = np.sqrt(self.cfg.UPSILON_BULGE / UPSILON_REF_BULGE)
        return {
            "M_gas": MASS_FACTOR * vg**2 * R,
            "M_disk": MASS_FACTOR * (vd*fd)**2 * R,
            "M_bulge": MASS_FACTOR * (vb*fb)**2 * R,
        }

    def _process(self, name, points):
        cfg = self.cfg
        if len(points) < cfg.MIN_TOTAL_POINTS:
            self._rejections.append((name, "too_few_total_points", f"N={len(points)}"))
            return None
        valid = []
        for p in points:
            try:
                vg, vd, vb = float(p["v_gas"]), float(p["v_disk"]), float(p["v_bulge"])
                vo, r = float(p["v_obs"]), float(p["radius"])
            except (KeyError, ValueError, TypeError): continue
            if not all(np.isfinite(x) for x in (vg, vd, vb, vo, r)): continue
            vbar = self._v_bar(vg, vd, vb)
            if not np.isfinite(vbar) or vbar < cfg.V_BAR_MIN_KMS: continue
            if vo <= vbar: continue
            phi = float(np.log(vo / vbar))
            if not np.isfinite(phi) or phi >= cfg.PHI_MAX: continue
            valid.append({"radius": r, "v_obs": vo, "v_bar": vbar, "phi": phi,
                          "v_gas": vg, "v_disk": vd, "v_bulge": vb})
        if not valid:
            self._rejections.append((name, "no_valid_points", "0")); return None
        self._counts["with_valid_points"] += 1

        sat = [p for p in valid if p["radius"] >= cfg.R_SAT_KPC]
        if len(sat) < cfg.N_SAT_MIN:
            self._rejections.append((name, "too_few_saturated", f"N_sat={len(sat)}"))
            return None
        self._counts["with_sat_points"] += 1

        rmax = max(valid, key=lambda p: p["radius"])
        R = float(rmax["radius"])
        m = self._masses(rmax["v_gas"], rmax["v_disk"], rmax["v_bulge"], R)
        Mbar = m["M_gas"] + m["M_disk"] + m["M_bulge"]
        if not np.isfinite(Mbar) or Mbar <= 0:
            self._rejections.append((name, "bad_mass", f"{Mbar}")); return None
        if Mbar >= cfg.M_BAR_MAX_MSUN:
            self._rejections.append((name, "mbar_exceeds_limit", f"{Mbar:.2e}"))
            return None
        self._counts["after_mass_cut"] += 1

        phis = [p["phi"] for p in sat]
        phi_Rmax = float(np.log(rmax["v_obs"] / rmax["v_bar"]))
        Sigma = Mbar / (np.pi * R**2)
        self._counts["total_sat_points"] += len(sat)

        return {
            "name": name, "N_total": len(points), "N_valid": len(valid),
            "N_saturated": len(sat), "R_max": R,
            "v_bar_Rmax": rmax["v_bar"], "v_obs_Rmax": rmax["v_obs"],
            "v_gas_Rmax": rmax["v_gas"], "v_disk_Rmax": rmax["v_disk"],
            "v_bulge_Rmax": rmax["v_bulge"],
            "phi_end": float(np.median(phis)),
            "phi_end_mean": float(np.mean(phis)),
            "phi_Rmax": phi_Rmax,
            "M_bar": Mbar, "M_disk": m["M_disk"],
            "M_gas": m["M_gas"], "M_bulge": m["M_bulge"],
            "Sigma": Sigma,
            "f_gas": m["M_gas"] / Mbar if Mbar > 0 else np.nan,
            "log_M_bar": float(np.log10(Mbar)),
        }

    @staticmethod
    def _enrich_logs(df: pd.DataFrame) -> pd.DataFrame:
        if len(df) == 0: return df
        for src, dst in [
            ("M_bar",  "log_M_bar"), ("M_disk", "log_M_disk"),
            ("M_gas",  "log_M_gas"), ("R_max",  "log_R_max"),
            ("Sigma",  "log_Sigma"),
            ("v_bar_Rmax", "log_vbar_Rmax"),
            ("v_obs_Rmax", "log_vobs_Rmax"),
        ]:
            if dst in df.columns: continue
            if src not in df.columns:
                df[dst] = np.nan; continue
            v = df[src].astype(float).to_numpy()
            v = np.where(np.isfinite(v) & (v > 0), v, np.nan)
            with np.errstate(divide="ignore", invalid="ignore"):
                df[dst] = np.log10(v)
        return df

    def build(self, galaxies):
        self._reset()
        self._counts["input"] = len(galaxies)
        rows = []
        for name in sorted(galaxies):
            r = self._process(name, galaxies[name])
            if r is not None: rows.append(r)
        df = pd.DataFrame(rows) if rows else pd.DataFrame(columns=self.EXPECTED_COLUMNS)
        df = self._enrich_logs(df)
        self._counts["final"] = len(df)
        self._print_report(df)
        return df

    def _print_report(self, df):
        c, cfg = self._counts, self.cfg
        self.rp.section("Sample construction")
        self.rp.info(f"Input galaxies                              : {c['input']}")
        self.rp.info(f"With ≥1 valid point                         : {c['with_valid_points']}")
        self.rp.info(f"With ≥{cfg.N_SAT_MIN} saturated (r ≥ {cfg.R_SAT_KPC} kpc)      : {c['with_sat_points']}")
        self.rp.info(f"After M_bar < {cfg.M_BAR_MAX_MSUN:.1e} M_⊙              : {c['after_mass_cut']}")
        self.rp.info(f"FINAL SAMPLE                                : {c['final']}")
        self.rp.info(f"Total saturated points                      : {c['total_sat_points']}")

    def rejections_df(self):
        return pd.DataFrame(self._rejections, columns=["name", "reason", "detail"])

    def counts(self) -> Dict[str, int]:
        return dict(self._counts)


